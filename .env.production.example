# ===================================================================
# PRODUCTION CONFIGURATION FOR porto.fauzan.online
# ===================================================================
# Copy file ini ke .env di server:
# cp .env.production.example .env
# 
# Lalu edit bagian yang di-mark dengan ⚠️
# ===================================================================

APP_NAME="Portfolio Fauzan"
APP_ENV=production
APP_KEY=base64:JANGAN_GANTI_KEY_YANG_SUDAH_ADA_DI_ENV_LAMA
# ☝️ ⚠️ PENTING: Gunakan APP_KEY dari .env yang sudah ada!
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# Domain Configuration
APP_URL=https://porto.fauzan.online
ASSET_URL=https://porto.fauzan.online

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio_db
DB_USERNAME=portfolio_user
DB_PASSWORD=your_database_password_here
# ☝️ ⚠️ Gunakan password database yang sudah ada di .env lama!

# ===================================================================
# SESSION & COOKIE CONFIGURATION (CLOUDFLARE TUNNEL)
# ===================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.fauzan.online
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===================================================================
# MAIL CONFIGURATION
# ===================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@fauzan.online"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===================================================================
# FILAMENT
# ===================================================================
FILAMENT_FILESYSTEM_DISK=public

# ===================================================================
# SANCTUM (API Authentication)
# ===================================================================
SANCTUM_STATEFUL_DOMAINS=porto.fauzan.online,fauzan.online

# ===================================================================
# CARA PAKAI DI SERVER:
# ===================================================================
# 1. Pull update dari git: git pull origin main
# 2. Backup .env lama: cp .env .env.backup
# 3. Copy file ini: cp .env.production.example .env
# 4. Edit .env: nano .env
#    - Copy APP_KEY dari .env.backup
#    - Copy DB_PASSWORD dari .env.backup
# 5. Clear cache: php artisan config:clear && php artisan optimize
# 6. Restart serve
# ===================================================================
